void main()
{
    char str[100];
    scanf("%s",str);
    int n=0;
    int j=0;
    while(str[j]!='\0')
    {
        n++;
        j++;
    }

    int visited[n];
    for(int i=0;i<n;i++)
    {
        visited[i] = 0;
    }

    for(int i=0;str[i]!='\0';i++)
    {
        if(visited[i]==0)
        {
            printf("%c",str[i]);
            for(int j=i+1;str[j]!='\0';j++)
            {
                if(str[j]==str[i])
                {
                    visited[j]=1;
                }
            }
        }
    }
}


