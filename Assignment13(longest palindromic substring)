#include <stdio.h>
#include <string.h>

int main() {
    char str[100];
    printf("Enter the string: ");
    scanf("%s", str);

    int n = strlen(str);
    int start = 0, maxLength = 0;

   
    for (int i = 0; i < n; i++) {
        
        int left = i, right = i;
        while (left >= 0 && right < n && str[left] == str[right]) {
            int len = right - left + 1;
            if (len > maxLength) {
                maxLength = len;
                start = left;
            }
            left--;
            right++;
        }

       
        left = i;
        right = i + 1;
        while (left >= 0 && right < n && str[left] == str[right]) {
            int len = right - left + 1;
            if (len > maxLength) {
                maxLength = len;
                start = left;
            }
            left--;
            right++;
        }
    }

    printf("Longest Palindromic Substring: ");
    for (int i = start; i < start + maxLength; i++) {
        printf("%c", str[i]);
    }
    printf("\n");

    return 0;
}
