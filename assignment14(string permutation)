#include <stdio.h>
#include <string.h>

int main() {
    char str[100];
    char temp;
    int n;

    printf("Enter the string: ");
    scanf("%s", str);

    n = strlen(str);


    int left = 0, right = n - 1;


    for (int i = left; i <= right; i++) {
       
        temp = str[left];
        str[left] = str[i];
        str[i] = temp;

       
        for (int j = left + 1; j <= right; j++) {
            
            for (int k = j; k <= right; k++) {
                temp = str[j];
                str[j] = str[k];
                str[k] = temp;

                
                if (j == right) {
                    printf("%s\n", str);
                }

               
                temp = str[j];
                str[j] = str[k];
                str[k] = temp;
            }
        }

   
        temp = str[left];
        str[left] = str[i];
        str[i] = temp;
    }

    return 0;
}
