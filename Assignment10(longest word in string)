void main()
{
    char str[100];
    scanf("%[^\n]",str);
    int large = 0;
    int count=0;
    int index;
    int k;
    for(int i=0;str[i]!='\0';i++)
    {
        if(str[i]!=32)
        {
            count = 0;
            k=i;
            while(str[i]!=32 && str[i]!='\0')
            {
                count++;
                i++;
            }
            if(count>large)
            {
                large = count;
                index = k;
            }
        }
    }
    printf("%d\n",index);

    while(str[index]!=32 && str[index]!='\0')
    {
        printf("%c",str[index]);
        index++;
    }
}
