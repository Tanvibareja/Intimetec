
#include<stdio.h>
void main()
{
    char str[1000];
    scanf("%[^\n]",str);
    getchar();
    char substring[1000];
    scanf("%[^\n]",substring);
    int n=0;
    int j=0;
    int count = 0;
    int flag =0;
    while(substring[n]!='\0')
    {
        n++;
    }

    for(int i=0;str[i]!='\0';i++)
    {
        if(str[i]==substring[0])
        {
            int k = i;
            while(substring[j]!='\0')
            {
                if(str[i]==substring[j])
                {
                    count++;
                    i++;
                    j++;
                }
            }
            if(count==n)
            {
                flag = 1;
                printf("%d",k);
                return;
            }
            else
            {
                count = 0;
                i = k;
                j = 0;
            }
        }
    }

    if(flag==0)
    {
        printf("-1");
    }
}
