#include<stdio.h>
#include<stdlib.h>
#define MAX 10
 
typedef struct node{
    int key;
    int value;
    struct node* next;
}node;
 
typedef struct hashmap{
    node* hashmap[MAX];
}hashmap;
 
void initialize_hashmap(hashmap* h){
    for(int i=0;i<MAX;i++){
        h->hashmap[i]=NULL;
    }
}
 
node* create_node(int key,int value){
    node* new=malloc(sizeof(node));
    new->next=NULL;
    new->key=key;
    new->value=value;
    return new;
}
 
int hash_function(int key){
    return key%MAX;
}
 
void insert(hashmap* h,int key,int value){
    int index=hash_function(key);
    node* new=create_node(key,value);
    if(h->hashmap[index]==NULL){
        h->hashmap[index]=new;
    }
    else{
        new->next=h->hashmap[index];
        h->hashmap[index]=new;
    }
}
 
void search(hashmap h,int key){
    int index=hash_function(key);
    node* temp=h.hashmap[index];
    if(temp!=NULL)
    {
        while(temp!=NULL){
            if(temp->key==key){
                printf("Value: %d\n",temp->value);
                return;
            }
            temp=temp->next;
        }
    }
    printf("Key %d not found\n",key);
}
 
void delete(hashmap* h,int key){
    int index=hash_function(key);
    node* temp=h->hashmap[index],*prev=NULL;
    if(temp!=NULL){
        while(temp!=NULL){
            if(temp->key==key){
                if(prev==NULL){
                    h->hashmap[index]=temp->next;
                }
                else{
                    prev->next=temp->next;
                }
                free(temp);
                printf("Key %d deleted\n",key);
                return;
            }
            prev=temp;
            temp=temp->next;
        }
    }
    printf("Key %d not found\n",key);
}
 
 
void display(hashmap h){
    printf("Hash Table:\n");
    for(int i=0;i<MAX;i++){
        if(h.hashmap[i]!=NULL){
            printf("Index %d: ",i);
            node* temp=h.hashmap[i];
            while(temp->next!=NULL){
                printf("(%d, %d)->",temp->key,temp->value);
                temp=temp->next;
            }
            printf("(%d, %d)\n",temp->key,temp->value);
        }
    }
}
 
enum MENU{
    INSERT=1,SEARCH,DELETE,DISPLAY,EXIT
};
 
int main(){
    hashmap h;
    int key,value,choice=0;
 
    initialize_hashmap(&h);
     while(choice!=5){
        printf("Enter your choice:");
        scanf("%d",&choice);
        switch(choice){
            case INSERT:
            printf("Enter key:");
            scanf("%d",&key);
            printf("Enter value:");
            scanf("%d",&value);
            insert(&h,key,value);
            break;
            case SEARCH:
            printf("Enter key:");
            scanf("%d",&key);
            search(h,key);
            break;
            case DELETE:
            printf("Enter key:");
            scanf("%d",&key);
            delete(&h,key);
            break;
            case DISPLAY:
            display(h);
            break;
            case EXIT:
            printf("Exiting program.\n");
            return 0;
        }
    }
    return 0;
}
