struct node * deletelast(struct node * head)
{
    struct node * temp;
    struct node * prev;

    if(head->next==NULL)
    {
        head=NULL;
        return head;
    }

    else
    {
        prev = head;
        temp = head->next;
        while(temp->next!=NULL)
        {
            temp = temp->next;
            prev = prev->next;
        }
        prev->next = NULL;
        return head;
    }
}


