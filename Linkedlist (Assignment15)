struct node
{
    int data;
    struct node * next;
};

struct node * addlast(struct node *head,int val)
{
    struct node * newnode;
    newnode = (struct node *)malloc(sizeof(struct node));
    newnode->data = val;
    newnode->next = NULL;
    struct node* temp;
    if(head==NULL)
    {
        head = newnode;
        return head;
    }
    else
    {
       temp = head;
       while(temp->next!=NULL)
       {
        temp = temp->next;
       }
       temp->next = newnode;
       return head;
    }
}



