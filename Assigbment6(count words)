
#include<stdio.h>
void main()
{
    char str[1000];
    scanf("%[^\n]",str);
    int count = 0;
    for(int i=0;str[i]!='\0';i++)
    {
        if(str[i]!=32)
        {
            count++;
            while(str[i]!=32)
            {
                i++;
            }
        }
    }
    printf("%d",count);
}
