int main() {
    char str[100];
    printf("Enter a string: ");
    scanf("%[^\n]", str);
    int num;
    int flag=1;
    int i =0;
    if(str[i]=='+' || str[i]=='-')
    {
        i++;
    }
    for(i=1;str[i]!='\0';i++)
    {
        if(!(str[i]>='0' && str[i]<='9'))
        {
            flag = 0;
            break;
        }
    }
    if(flag==0)
    {
        return 0;
    }
    else if(flag==1)
    {
    num = atoi(str);
    printf("%d",num);
    }

    return num;
}
